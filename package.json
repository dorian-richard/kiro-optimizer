{
  "name": "kiro-optimizer",
  "version": "0.1.0",
  "description": "Token optimizer for Kiro (IDE + CLI): budgeted code intelligence MCP, output compression, session governor hooks; runs entirely on the developer machine",
  "type": "module",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dorian-richard/kiro-optimizer.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "kopt": "dist/bin.js"
  },
  "files": [
    "dist",
    "templates",
    "vendor",
    "bench/ab/README.md",
    "bench/ab/tasks.example.json",
    "bench/ab/fake-kiro-cli.mjs",
    "bench/ab/fake-kiro-cli.cmd",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench": "tsx src/bench/cli.ts",
    "bench:page": "node scripts/build-benchmarks-page.mjs",
    "bench:compress": "node bench/compress/run.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^14.0.3",
    "ignore": "^7.0.12",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.25.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
